# CapAuth + Forgejo compose stack: environment configuration.
# Copy to .env and set STRONG unique secrets before running the stack:
#   cp .env.example .env
#   ./preflight.sh          # refuses to run while these are default/empty
#
# Generate a strong value with:
#   python3 -c 'import secrets; print(secrets.token_hex(32))'

# Security: REQUIRED. CHANGE both before running. No default is committed;
# compose hard-fails if unset/empty, and preflight.sh rejects these placeholders.
CAPAUTH_ADMIN_TOKEN=change-me-admin-token-min-32-chars
CAPAUTH_JWT_SECRET=change-me-jwt-secret-at-least-32-chars
